          "京东"
        ],
        "competitors": [
          "欧莱雅"
        ],
        "products": [
          "控油洁面"
        ]
      },
      "start": "新建或续用同一模式的空/已初始化目录；--year 默认上海当前年，续跑沿用建档年"
    },
    "select": "select ID [...] --trial（仅试跑）或 --confirmed（仅正式）；每款本品最多一个 ID。另一次明确 --replace 可换款并保存历史",
    "source_boundary": "离线；域名、字段、关联、文件格式/像素可校验，原图内容、SKU 对应、页面真伪和授权由导入者根据截图核实"
  }
}
