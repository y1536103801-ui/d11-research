{
  "$defs": {
    "candidate": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "maxLength": 12000,
          "minLength": 1,
          "type": "string"
        },
        "brand": {
          "maxLength": 12000,
          "minLength": 1,
          "type": "string"
        },
        "image": {
          "maxLength": 4096,
          "type": [
            "string",
            "null"
          ]
        },
        "platform": {
          "enum": [
            "抖音",
            "天猫",
            "淘宝",
            "京东",
            "品牌官网",
            "官网",
            "官方网站",
            "品牌官方网站",
            "抖音商城",
            "京东商城"
          ]
        },
        "product": {
          "enum": [
            "冰川保湿抗皱",
            "冰川露",
            "喷喷乳",
            "控油洁面"
          ]
        },
        "role": {
          "enum": [
            "own",
            "competitor"
          ]
        },
        "shop": {
          "maxLength": 12000,
          "minLength": 1,
          "type": "string"
        },
        "sku": {
          "maxLength": 12000,
          "minLength": 1,
          "type": "string"
        },
        "title": {
          "maxLength": 12000,
          "minLength": 1,
          "type": "string"
        },
        "url": {
          "format": "uri",
          "maxLength": 4096,
          "pattern": "^https?://",
          "type": "string"
        }
      },
      "required": [
        "product",
        "role",
        "brand",
        "title",
        "sku",
        "url",
        "platform",
        "shop",
        "basis"
      ],
      "type": "object"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/candidate"
      },
      "type": "array"
    },
    "observation": {
      "additionalProperties": false,
      "properties": {
        "assets": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 128,
          "type": "array"
        },
        "candidate_id": {
          "maxLength": 12000,
          "minLength": 1,
          "type": "string"
        },
        "excerpt": {
          "maxLength": 12000,
          "minLength": 1,
          "type": "string"
        },
        "fields": {
          "additionalProperties": {
            "maxLength": 12000,
            "minLength": 1,
            "type": "string"
          },
          "propertyNames": {
            "maxLength": 80,
            "pattern": "[㐀-鿿]",
            "type": "string"
          },
          "type": "object"
        },
        "kind": {
          "enum": [
            "campaign",
            "current",
            "offer",
            "rule"
          ]
        },
        "observed_at": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt ]\\d{2}:\\d{2}(:\\d{2}(\\.\\d+)?)?([Zz]|[+-]\\d{2}:?\\d{2})$",
          "type": "string"
        },
        "original": {
          "type": "boolean"
        },
        "original_assets": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 128,
          "type": "array"
        },
        "platform": {
          "enum": [
            "抖音",
            "天猫",
            "淘宝",
            "京东",
            "品牌官网",
            "官网",
            "官方网站",
            "品牌官方网站",
            "抖音商城",
            "京东商城"
          ]
        },
        "scope": {
          "enum": [
            "product_page",
            "brand_page",
            "rule_page",
            "checkout",
            "live"
          ]
        },
        "screenshot_assets": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 128,
          "type": "array"
        },
        "shop": {
          "maxLength": 12000,
          "minLength": 1,
          "type": "string"
        },
        "url": {
          "format": "uri",
          "maxLength": 4096,
          "pattern": "^https?://",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "platform",
        "shop",
        "kind",
        "scope",
        "observed_at",
        "url",
        "excerpt",
        "assets",
        "fields",
        "original"
      ],
      "type": "object"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/observation"
      },
      "type": "array"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/candidates"
    },
    {
      "$ref": "#/$defs/observations"
    }
  ],
  "title": "双十一调研 CLI 输入清单",
  "x-cli": {
    "candidates": {
      "optional": {
        "image": "批次内本地图片路径；直接进入候选清单，不算正式原图"
      },
      "platform": "本批次渠道或品牌官网（官网亦可）；平台必须与来源域名相符",
      "required_strings": [
        "product",
        "role",
        "brand",
        "title",
        "sku",
        "url",
        "platform",
        "shop",
        "basis"
      ],
      "role": [
        "own",
        "competitor"
      ],
      "type": "对象列表"
    },
    "export": "JSON 回执含 export_dir/report；exports 下分试跑/正式快照，原图二级目录、候选清单.html、证据表.html/.json、待补.txt、报告输入.json、Word。相同状态/程序复用经校验快照",
    "observe": {
      "assets": "本批次本地文件路径列表；可为空，缺证据时仅留线索",
