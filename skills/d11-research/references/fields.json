        }
      },
      "kind": [
        "campaign",
        "current",
        "offer",
        "rule"
      ],
      "observed_at": "ISO 8601 日期时间，必须含时区",
      "offer_gate": {
        "all": "所选候选、本渠道商品/直播/结算页、页面规格=候选 sku、独立标注的截图",
        "campaign": "活动价/福利另需活动期；宣传价和活动标价限 product_page/live",
        "checkout": "结算实见价只允许 checkout，另需结算条件",
        "daily": "日常价另需单独的同规格非促销日常价记录，限 product_page；划线价/吊牌价不算",
        "prices": [
          "日常价",
          "活动标价",
          "宣传到手价",
          "结算实见价"
        ],
        "stacking": "一条只记一种价格；不推算叠券、跨店满减、会员到手价"
      },
      "optional": {
        "original_assets": "assets 的图片子集；按字节区分原图与页面截图",
        "screenshot_assets": "assets 的图片子集；按字节区分原图与页面截图"
      },
      "original": "JSON 布尔值；true 自身不证明原图",
      "required": [
        "candidate_id",
        "platform",
        "shop",
        "kind",
        "scope",
        "observed_at",
        "url",
        "excerpt",
        "assets",
        "fields",
        "original"
      ],
      "rule_gate": "已选候选，本渠道规则/商品说明/直播、活动期，附本地文字/PDF原文或明确标注的截图；不推断 SKU 可用",
      "scope": [
        "product_page",
        "brand_page",
        "rule_page",
        "checkout",
        "live"
      ],
      "type": "对象列表"
    },
    "paths": "清单 FILE 相对命令工作目录；image/assets 及两类附件角色相对 --run 或用批次内绝对路径；禁跨批次、符号链接、..",
    "report_api": "同目录 report.py: write_report(path: pathlib.Path, data: dict)；entries.assets 为绝对本地路径",
    "run": {
      "channels": "新批次默认天猫、淘宝、京东；start --channels 可选。旧批次沿用建档时的范围。",
      "formal": {
